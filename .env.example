# =============================================================================
# UnifiedNetworkManager — environment overrides (copy to .env and edit)
#
#   cp .env.example .env
#
# HOW IT WORKS
#   Docker Compose auto-reads a local `.env` file (next to the compose file) and
#   uses its values to override the built-in defaults. Every variable below has
#   a sane default, so:
#     • DEV  — you can skip this entirely; `./setup.sh` / `docker compose up`
#              works out of the box with zero configuration.
#     • PROD — copy this file to `.env` and change at least everything marked
#              "MUST CHANGE" (insecure defaults) before going live.
#   Values can also be supplied as real environment variables instead of a file;
#   an exported variable wins over the `.env` file.
# =============================================================================


# -----------------------------------------------------------------------------
# MUST CHANGE IN PRODUCTION — insecure defaults that protect data at rest / in
# transit between UNM's own containers. Leaving these at their dev values means
# anyone who obtains your Postgres volume or a container image can read every
# stored credential.
# -----------------------------------------------------------------------------

# Master key used to encrypt secrets (device credentials, API tokens) at rest.
# The default is a public placeholder — you MUST set a long random value in prod.
# Generate one with:  openssl rand -hex 32
MASTER_KEY=default-master-key-must-be-changed-in-production

# Salt for credential hashing. Change to a unique random string in prod.
CRYPTO_SALT=salt

# Postgres superuser + password (the `unm` app database). The default password
# is the username — change it in prod.
POSTGRES_USER=unm
POSTGRES_PASSWORD=unm
POSTGRES_DB=unm

# Shared key between the API and every plugin container (internal network only,
# but still a secret). Change to a random value in prod.
PLUGIN_API_KEY=dev-plugin-key


# -----------------------------------------------------------------------------
# RECOMMENDED IN PRODUCTION — set these to match your real deployment so 2FA /
# passkeys and port exposure behave correctly behind your domain + TLS.
# -----------------------------------------------------------------------------

# WebAuthn (passkey) identity. In prod point these at your public origin:
#   WEBAUTHN_RP_ID=unm.example.com
#   WEBAUTHN_ORIGIN=https://unm.example.com
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:8080

# Host port the webapp is published on.
UNM_WEB_PORT=8080

# Timezone for logs / scheduled jobs (IANA name).
TZ=UTC


# -----------------------------------------------------------------------------
# IMAGE SELECTION — only meaningful for the end-user `docker-compose.yml`
# (the dev file builds from source and ignores these).
# -----------------------------------------------------------------------------

# Tag to pull. `dev` = latest main build; use a release tag like `v0.1.0` for a
# stable deployment, or `nightly` for the newest pre-release.
UNM_IMAGE_TAG=dev

# Registry prefix (override only if you mirror the images elsewhere).
UNM_REGISTRY=ghcr.io/michaelkirgus/unifiednetworkmanager


# -----------------------------------------------------------------------------
# OPTIONAL / ADVANCED — leave unset unless you need them.
# -----------------------------------------------------------------------------

# Fleet-wide mTLS: set to 1 to enable ACME enrollment + the API's :8443 listener.
# Off by default (plain HTTP on :3000). See docs/ for the CA setup.
#UNM_TLS=

# Expose the MCP server on a host port. UNSET = not published (recommended — it
# carries an API token with full agent capabilities). Set e.g. 8081 only if you
# need remote MCP access, and put auth / a reverse proxy in front of it.
#UNM_MCP_PORT=

# Bearer key gating the MCP `/mcp` endpoint (empty = open on the internal net).
#MCP_KEY=

# Key gating the MCP debug surface (`/debug/mcp`) + the CA renew proxy. Change if
# you expose the MCP server to anything beyond your LAN.
MCP_DEBUG_KEY=dev-mcp-debug-key

# Long-lived API token for external tooling / the MCP server to call the API with.
# Mint one from the webapp (Tokens page) and paste it here if needed.
#UNM_API_TOKEN=

# Egress proxy URL for the web-fetch plugin (e.g. http://proxy:3128). Leave unset
# for direct internet access.
#WEBFETCH_PROXY_URL=

# How many days to keep plugin logs / metrics before pruning.
LOG_RETENTION_DAYS=7


# -----------------------------------------------------------------------------
# INTERNAL — leave at their defaults. These are volume names and fixed plugin
# UUIDs referenced across services; changing them can break the stack. Listed
# here only so a grep for a variable name finds it.
# -----------------------------------------------------------------------------
AUTH_PLUGIN_ID=00000000-0000-4000-8000-000000000001
SECRETS_PLUGIN_ID=00000000-0000-4000-8000-000000000002
FILE_REPO_PLUGIN_ID=00000000-0000-4000-8000-000000000011
FILE_REPO_PATH=/data/file-repo
FILE_REPO_PLUGIN_VOLUME=filerepo-plugin
UNM_API_TLS_VOLUME=unm-api-tls
UNM_MCP_TLS_VOLUME=unm-mcp-tls
UNM_CA_CONFIG_VOLUME=unm-ca-cfg
UNM_CA_PKI_VOLUME=unm-ca-pki

# Legacy OPNsense bootstrap vars — not currently consumed by any plugin (devices
# are configured in the webapp instead). Kept only for compose parity; safe to ignore.
OPNSENSE_HOST=https://opnsense.local
OPNSENSE_KEY=
OPNSENSE_SECRET=
