{
  "name": "unm-mcp",
  "version": "0.1.0",
  "license": "EUPL-1.2",
  "private": true,
  "description": "Model Context Protocol server for UnifiedNetworkManager — exposes the API's OpenAPI operations as MCP tools (stdio, or HTTP with /mcp + /debug/mcp when MCP_PORT is set). Authenticated with a long-lived UNM API token.",
  "type": "module",
  "bin": {
    "unm-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@unm/plugin-sdk": "file:../packages/plugin-sdk",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "undici": "^6.21.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.3.2"
  }
}
